# Every setting here is optional: the Press runs with no .env at all, and
# writes its own paper from the feeds in sources.toml. Copy this file to .env
# to change something. .env is ignored by git; never commit it.

# Optional. Set these only when something else writes the paper: the Press
# then stops running its own sources and prints the edition staged at this
# address. For the built-in demo staging server (docker compose --profile
# staging), use http://stage:8485 and any token you like.
# STAGE_URL=https://stage.example.com
# STAGE_TOKEN=change-me-to-a-long-random-string

# Optional. Set this to let `mnn rebuild` (or anything else that sends the
# token) reprint today's edition through POST /api/rebuild. Unset, that
# address is off. Make it long and random, for example: openssl rand -hex 32
# PRESS_TOKEN=change-me-to-a-long-random-string

# Optional. Set this and a section with source = "editor" in sources.toml is
# chosen and written by Claude; the default paper's front page is one. Unset,
# those sections are printed straight from their feeds. Get a key at
# https://platform.claude.com/. The headlines and summaries of the stories
# the editor chooses from leave your network; see docs/security.md.
# ANTHROPIC_API_KEY=

# Your time zone, so the times below mean local time. Default: UTC.
TZ=America/New_York

# When the day's edition is due. The Press prints (or first checks staging)
# at this time, and the Kindle is told to wake five minutes later. Later
# checks (a retry after a failure, or an edition staged late) follow every
# ten minutes, but only until 09:00 whatever this is set to, so an edition
# time after 09:00 gets a single check each day.
EDITION_TIME=06:40

# The directory holding your own files (see "Where your files live" in
# docs/sources.md), mounted read-only at /config. Default: ./config
# PRESS_CONFIG=./config

# The directory section files are left in for the inbox source, mounted at
# /inbox. The Press moves printed files within it. Default: ./inbox
# PRESS_INBOX=./inbox

# Port the Kindle reaches the Press on.
PRESS_PORT=8484

# Only for `--profile staging`: the port the demo staging server listens on.
STAGE_PORT=8485

# Messages to a paired Muse gadget after each print. `every` sends one line a
# morning and a message when something goes wrong; `problems` stays silent on
# good mornings; `off` (the default) sends nothing.
# MUSE_MESSAGES=off
# `counts` (the default) or `headlines`, which adds the leading headlines to
# the morning line. Headlines then leave your network for Muse's cloud.
# MUSE_DETAIL=counts
# Minutes to wait for the Kindle after a print before saying it has not
# fetched the paper, 720 (twelve hours) at most. 0 never waits for, or
# mentions, the Kindle.
# MUSE_KINDLE_WAIT=60
# Optional: a side chat to post into (letters, digits and dashes).
# MUSE_SESSION_ID=mnn-press
# Optional: after each print, ask Muse to draw the Press's card on a gadget
# with a screen. The value is the card's address as that gadget reaches it on
# your network (this machine's LAN address, not localhost). Unset, the card
# is still served but nothing asks for it.
# MUSE_CARD_URL=http://192.168.1.20:8484/card.jpg
# Needed under docker compose with MUSE_MESSAGES or MUSE_CARD_URL, or with a
# section that asks Muse a question at print time (source = "ask" in
# sources.toml): the mount of the host's gadget socket, and the group that may
# open it. See docs/muse.md.
# COMPOSE_FILE=docker-compose.yml:integrations/muse/docker-compose.yml
# MUSE_GID=

# Only for `--profile gadget`: the Muse gadget SDK token.
MUSEGADGET_SDK_TOKEN=
